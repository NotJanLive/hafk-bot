# Copy to .env for local development. Never commit the real .env.

# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=
# Optional: register slash commands only in this guild (instant updates while developing)
DISCORD_DEV_GUILD_ID=

# MariaDB
DB_URL=jdbc:mariadb://localhost:3306/hafk
DB_USER=hafk
DB_PASSWORD=
DB_POOL_SIZE=5

# Internal REST API for the dashboard. Keep it on localhost / the internal docker network.
BOT_API_HOST=127.0.0.1
BOT_API_PORT=8081
# Shared secret with the dashboard, at least 32 characters (e.g. `openssl rand -hex 32`)
BOT_API_TOKEN=

# Public dashboard URL, used for links in Discord (only https links are shown)
DASHBOARD_URL=http://localhost:3000

LOG_LEVEL=INFO
